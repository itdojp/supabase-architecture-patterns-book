{
  "name": "supabase-architecture-patterns-book",
  "version": "1.0.0",
  "description": "Supabaseアーキテクチャパターン - 実践的な設計手法",
  "author": "ITDO Inc.（株式会社アイティードゥ）",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "start": "bundle exec jekyll serve --source docs --config docs/_config.yml --destination _site --livereload",
    "build": "bundle exec jekyll build --source docs --config docs/_config.yml --destination _site",
    "build:gh-pages": "bundle exec jekyll build --source docs --config docs/_config.yml --destination _site",
    "preview": "npm run build && npx http-server _site -p 8080 --silent",
    "deploy": "gh-pages -d _site",
    "clean": "rm -rf _site .jekyll-cache",
    "test": "npm run check:metadata && npm run check:auth-users-boundary && npm run check:authz-claims && npm run check:chapter04-example && npm run test:chapter04-example && npm run check:security && npm run lint && npm run check-links:self-test && npm run check-links",
    "lint": "markdownlint 'src/**/*.md' --ignore node_modules",
    "lint:light": "markdownlint 'src/**/*.md' --ignore node_modules",
    "check-links": "node scripts/check-source-links.js --mode internal",
    "check-links:self-test": "node scripts/check-source-links.js --self-test",
    "check-links:external": "node scripts/check-source-links.js --mode external",
    "check-links:built": "node scripts/check-source-links.js --built-site _site",
    "check-conflicts": "echo 'No Jekyll conflicts to check'",
    "help": "echo 'Available commands:\n  npm start - Start development server\n  npm run build - Build the book\n  npm run preview - Local preview\n  npm run deploy - Deploy to GitHub Pages'",
    "check:metadata": "python3 scripts/check_metadata_consistency.py",
    "check:auth-users-boundary": "node scripts/check-auth-users-boundary.js",
    "check:security": "npm audit --omit=optional",
    "check:authz-claims": "node scripts/check-authz-claims.js",
    "check:chapter04-example": "node scripts/check-chapter04-example.js",
    "test:chapter04-example": "deno test examples/chapter04-ecommerce/supabase/functions/process-order/",
    "smoke:chapter04-local": "bash scripts/smoke-chapter04-local.sh"
  },
  "devDependencies": {
    "deno": "2.9.3",
    "gh-pages": "^6.3.0",
    "http-server": "^14.1.1",
    "markdown-it": "14.3.0",
    "markdown-link-check": "^3.14.2",
    "markdownlint-cli": "^0.48.0",
    "supabase": "2.109.1"
  },
  "keywords": [
    "book",
    "documentation",
    "japanese",
    "supabase",
    "architecture",
    "patterns"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itdojp/supabase-architecture-patterns-book.git"
  },
  "bugs": {
    "url": "https://github.com/itdojp/supabase-architecture-patterns-book/issues"
  },
  "homepage": "https://itdojp.github.io/supabase-architecture-patterns-book/",
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "5.3.0",
    "markdown-it": "14.3.0",
    "linkify-it": "5.0.2",
    "undici": "7.29.0"
  }
}
